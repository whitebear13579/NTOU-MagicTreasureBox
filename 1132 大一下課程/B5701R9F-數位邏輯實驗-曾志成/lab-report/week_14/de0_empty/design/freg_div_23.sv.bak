module freg_div_23 (
    input  logic clk,      
    input  logic reset,    
    output logic clk_out   
);
    logic [31:0] q;

    always_ff @(posedge clk or posedge reset)
    begin
        if (reset)
            q <= 0;
        else
            q <= q+1;
    end

  assign clk_out = q[15];
endmodule